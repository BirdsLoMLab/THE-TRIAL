# Firebase web config. Public by design; security lives in firestore.rules.
# Copy to .env.local and fill in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web push certificate key pair (Cloud Messaging tab). Used by the web build in Phase 3.
VITE_FIREBASE_VAPID_KEY=
